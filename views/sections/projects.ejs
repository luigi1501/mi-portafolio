<section class="projects-archive" id="proyectos">
    <div class="section-header">
        <span class="section-tag" data-i18n="projects.tag">Casos de Estudio</span>
        <h2 class="page-title" data-i18n="projects.title">Proyectos Destacados</h2>
        <p class="subtitle" data-i18n="projects.subtitle">
            Cada proyecto es un caso de estudio enfocado en resolver problemas de negocio, tomar decisiones técnicas justificadas y generar impacto real.
        </p>
    </div>

    <div class="carousel-wrapper">
        <div class="carousel-drag-hint">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8L22 12L18 16M6 8L2 12L6 16M2 12H22"/></svg>
            <span data-i18n="projects.drag-hint">Desliza o arrastra para ver más proyectos</span>
        </div>

        <div class="carousel-viewport" id="projects-carousel-viewport" tabindex="0" data-i18n-aria="projects.carousel-aria" aria-label="Carrusel de Proyectos">
            <div class="carousel-track" id="projects-carousel-track">
                <% todosLosProyectos.forEach(proyecto => { %>
                <div class="carousel-slide">
                    <article class="project-card">
                        <div class="card-info">
                            <div class="project-header-meta">
                                <span class="project-year"><%= proyecto.fecha %></span>
                                <span class="case-study-badge" data-i18n="projects.case-study-badge">💡 Caso de Estudio</span>
                                <% if (proyecto.enProceso) { %>
                                    <span class="status-in-progress" data-i18n="projects.status-in-progress">⚡ En Proceso</span>
                                <% } else { %>
                                    <span class="status-completed" data-i18n="projects.status-completed">✓ Completado</span>
                                <% } %>
                            </div>

                            <h3 data-lang-es="<%= proyecto.nombre %>" data-lang-en="<%= proyecto.nombre_en || proyecto.nombre %>"><%= proyecto.nombre %></h3>
                            <p class="summary" data-lang-es="<%= proyecto.resumen %>" data-lang-en="<%= proyecto.resumen_en || proyecto.resumen %>"><%= proyecto.resumen %></p>

                            <div class="tech-tags">
                                <% proyecto.tecnologias.forEach(tech => { %>
                                <%
                                    const cleanTag = tech.toLowerCase().split('(')[0].trim();
                                    let icon = { type: 'none' };
                                    switch (cleanTag) {
                                        case 'node.js': case 'node': icon = { type: 'devicon', class: 'devicon-nodejs-plain colored' }; break;
                                        case 'express': icon = { type: 'devicon', class: 'devicon-express-original' }; break;
                                        case '.net 10': case '.net': case '.net maui': case 'asp.net core web api': icon = { type: 'devicon', class: 'devicon-dotnetcore-plain colored' }; break;
                                        case 'c#': icon = { type: 'devicon', class: 'devicon-csharp-plain colored' }; break;
                                        case 'python': icon = { type: 'devicon', class: 'devicon-python-plain colored' }; break;
                                        case 'flask': icon = { type: 'devicon', class: 'devicon-flask-original colored' }; break;
                                        case 'django': icon = { type: 'devicon', class: 'devicon-django-plain colored' }; break;
                                        case 'blazor': icon = { type: 'devicon', class: 'devicon-blazor-original colored' }; break;
                                        case 'tailwind css': case 'tailwind': icon = { type: 'devicon', class: 'devicon-tailwindcss-plain colored' }; break;
                                        case 'javascript': case 'js': icon = { type: 'devicon', class: 'devicon-javascript-plain colored' }; break;
                                        case 'mongodb': icon = { type: 'devicon', class: 'devicon-mongodb-plain colored' }; break;
                                        case 'mysql': icon = { type: 'devicon', class: 'devicon-mysql-plain colored' }; break;
                                        case 'postgresql': icon = { type: 'devicon', class: 'devicon-postgresql-plain colored' }; break;
                                        case 'sqlite': icon = { type: 'devicon', class: 'devicon-sqlite-plain colored' }; break;
                                        case 'supabase': icon = { type: 'devicon', class: 'devicon-supabase-plain colored' }; break;
                                        case 'html5': case 'html': icon = { type: 'devicon', class: 'devicon-html5-plain colored' }; break;
                                        case 'css3': case 'css': icon = { type: 'devicon', class: 'devicon-css3-plain colored' }; break;
                                        case 'bootstrap': icon = { type: 'devicon', class: 'devicon-bootstrap-plain colored' }; break;
                                        case 'vercel': icon = { type: 'devicon', class: 'devicon-vercel-original' }; break;
                                        case 'chart.js': icon = { type: 'devicon', class: 'devicon-chartjs-plain colored' }; break;
                                        case 'ejs': icon = { type: 'img', src: '/images/ejs.svg' }; break;
                                        case 'tidb': case 'tidb cloud': icon = { type: 'img', src: '/images/tidb.svg' }; break;
                                        case 'turso': case 'turso cloud': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2dd4bf" stroke-width="2" style="vertical-align:middle;flex-shrink:0"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>' }; break;
                                        case 'cloudinary': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;flex-shrink:0"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>' }; break;
                                        case 'render': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#c084fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;flex-shrink:0"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>' }; break;
                                        case 'docker': icon = { type: 'devicon', class: 'devicon-docker-plain colored' }; break;
                                        case 'sql/nosql': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#60a5fa" stroke-width="2" style="vertical-align:middle;flex-shrink:0"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>' }; break;
                                        case 'restful apis': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;flex-shrink:0"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>' }; break;
                                        case 'qr code scanner': icon = { type: 'svg', html: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#34d399" stroke-width="2" style="vertical-align:middle;flex-shrink:0"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>' }; break;
                                    }
                                %>
                                <span class="tag <%= (icon.type !== 'none') ? 'has-logo' : '' %>">
                                    <% if (icon.type === 'devicon') { %>
                                        <i class="tag-icon <%= icon.class %>"></i>
                                    <% } else if (icon.type === 'img') { %>
                                        <img class="tag-icon tag-icon-img" src="<%= icon.src %>" alt="<%= tech %> logo" width="16" height="16" loading="lazy" />
                                    <% } else if (icon.type === 'svg') { %>
                                        <span class="tag-icon-svg-wrapper"><%- icon.html %></span>
                                    <% } %>
                                    <%= tech %>
                                </span>
                                <% }) %>
                            </div>
                        </div>

                        <div class="card-actions">
                            <button 
                                class="btn btn-secondary open-modal-btn"
                                data-proyecto='<%= JSON.stringify(proyecto) %>' 
                            >
                                <span data-i18n="projects.btn-view-case">Ver Caso de Estudio</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M14 10l6-6M9 21H3v-6M10 14l-6 6"/></svg>
                            </button>
                        </div>
                    </article>
                </div>
                <% }) %>
            </div>
        </div>

        <div class="carousel-controls">
            <div class="carousel-arrows">
                <button id="carousel-prev" class="carousel-arrow" data-i18n-aria="projects.prev-aria" aria-label="Proyecto anterior">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button id="carousel-next" class="carousel-arrow" data-i18n-aria="projects.next-aria" aria-label="Siguiente proyecto">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            </div>
            <div id="carousel-dots" class="carousel-dots"></div>
        </div>
    </div>
</section>

<div id="project-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
        <button class="close-btn" data-i18n-aria="modal.close-aria" aria-label="Cerrar modal">&times;</button>
        <div class="modal-body">
            <div class="modal-header-container">
                <span class="case-study-pill" data-i18n="modal.case-study-pill">Caso de Estudio Técnico</span>
                <h2 id="modal-title"></h2>
                <div id="modal-status" class="modal-status-badge"></div>
            </div>
            
            <div id="modal-tech-tags" class="tech-tags"></div>

            <div id="modal-story-container" class="modal-story-container">
                <div class="story-box story-problem">
                    <div class="story-box-header">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                        <h4 data-i18n="modal.challenge-header">El Desafío / Problema Real</h4>
                    </div>
                    <p id="modal-problem-text"></p>
                </div>

                <div class="story-box story-solution">
                    <div class="story-box-header">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                        <h4 data-i18n="modal.architecture-header">Arquitectura & Decisión Técnica</h4>
                    </div>
                    <p id="modal-solution-text"></p>
                </div>

                <div class="story-box story-impact">
                    <div class="story-box-header">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                        <h4 data-i18n="modal.impact-header">Impacto & Aprendizajes</h4>
                    </div>
                    <p id="modal-impact-text"></p>
                </div>
            </div>

            <p id="modal-description" class="modal-description-text" style="display: none;"></p>

            <div class="modal-actions">
                <a id="modal-link-demo" class="btn btn-primary" target="_blank" style="display: none;">
                    <span data-i18n="modal.btn-live-demo">Ver Demo en Vivo</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
                <a id="modal-link-repo" class="btn btn-secondary" target="_blank">
                    <span data-i18n="modal.btn-source-code">Ver Código Fuente</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
                </a>
            </div>
        </div>
    </div>
</div>