<section class="contact-section" id="contacto">
    <div class="section-header">
        <span class="section-tag" data-i18n="contact.tag">Contacto Directo</span>
        <h2 class="page-title" data-i18n="contact.title">¡Hablemos de tu Proyecto!</h2>
        <p class="subtitle" data-i18n="contact.subtitle">
            Estoy disponible para nuevos proyectos, consultas o colaboración. Te responderé en menos de 24 horas.
        </p>
    </div>

    <!-- Contenedor de Mensajes de Estado (Éxito/Error) -->
    <div id="statusMessage" class="alert hidden"></div>

    <!-- El FORMULARIO - Envío manejado por JavaScript -->
    <form id="contactForm" class="contact-form">
        <div class="form-group">
            <label for="from_name" data-i18n="contact.label-name">Nombre Completo</label>
            <input
                type="text"
                id="from_name"
                name="from_name"
                required
                placeholder="Tu Nombre"
                data-i18n-placeholder="contact.placeholder-name"
                class="form-input"
            />
        </div>
        <div class="form-group">
            <label for="from_email" data-i18n="contact.label-email">Correo Electrónico</label>
            <input
                type="email"
                id="from_email"
                name="from_email"
                required
                placeholder="tu.correo@ejemplo.com"
                data-i18n-placeholder="contact.placeholder-email"
                class="form-input"
            />
        </div>
        <div class="form-group">
            <label for="message" data-i18n="contact.label-message">Mensaje</label>
            <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Cuéntame sobre tu proyecto o consulta..."
                data-i18n-placeholder="contact.placeholder-message"
                class="form-textarea"
                style="resize: none !important;"
            ></textarea>
        </div>
        <button type="submit" id="submitButton" class="btn btn-primary" data-i18n="contact.btn-send">Enviar Mensaje</button>
    </form>
</section>

<!-- 2. JAVASCRIPT DE ENVÍO DE EMAILJS -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('contactForm');
        const statusMessage = document.getElementById('statusMessage');
        const submitButton = document.getElementById('submitButton');
        const messageInput = document.getElementById('message');

        // Auto-expandir el campo de mensaje según el contenido introducido
        if (messageInput) {
            const autoExpand = () => {
                messageInput.style.height = 'auto';
                messageInput.style.height = Math.max(160, messageInput.scrollHeight) + 'px';
            };
            messageInput.addEventListener('input', autoExpand);
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();

            // Deshabilitar botón y limpiar mensajes
            submitButton.disabled = true;
            submitButton.textContent = window.t ? window.t('contact.sending') : 'Enviando...';
            statusMessage.textContent = '';
            statusMessage.className = 'alert hidden'; 

            // Parámetros del servicio EmailJS
            const serviceID = "service_akz9jkw"; 
            const templateID = "template_6cq3ak2";
            
            emailjs.sendForm(serviceID, templateID, form)
                .then(function() {
                    // Éxito:
                    const msg = window.t ? window.t('contact.success-msg') : '¡Mensaje Enviado! Te contactaré pronto.';
                    statusMessage.innerHTML = '<strong>' + msg + '</strong>';
                    statusMessage.classList.add('alert-success');
                    form.reset(); // Limpiar el formulario
                }, function(error) {
                    // Error:
                    console.error('EmailJS Error:', error);
                    const errMsg = window.t ? window.t('contact.error-msg') : 'Error al Enviar: Intenta más tarde.';
                    statusMessage.innerHTML = '<strong>' + errMsg + '</strong>';
                    statusMessage.classList.add('alert-error');
                })
                .finally(function() {
                    // Habilitar botón de nuevo
                    submitButton.disabled = false;
                    submitButton.textContent = window.t ? window.t('contact.btn-send') : 'Enviar Mensaje';
                    statusMessage.classList.remove('hidden');
                });
        });
    });
</script>
