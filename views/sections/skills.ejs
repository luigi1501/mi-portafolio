<section class="skills-section" id="habilidades">
	<div class="section-header">
		<span class="section-tag" data-i18n="skills.tag">Habilidades & Stack</span>
		<h2 class="page-title" data-i18n="skills.title">Habilidades Técnicas & Experiencia</h2>
		<p class="subtitle" data-i18n="skills.subtitle">
			Stack tecnológico moderno centrado en rendimiento, arquitectura limpia y soluciones escalables.
		</p>
		<div class="badge-wrapper">
			<span class="experience-badge">
				🚀 <span data-i18n="skills.period-label">Período de experiencia activa:</span> <%= periodoExperiencia %>
			</span>
		</div>
	</div>

	<div class="skills-summary-box">
		<p class="summary-paragraph" data-i18n="skills.summary1">
			Mi enfoque principal se centra en el desarrollo backend con <strong>Node.js</strong> y <strong>Express</strong>, complementado con aplicaciones sólidas en <strong>Python</strong>. Poseo amplia experiencia en el diseño e integración de bases de datos relacionales y NoSQL como <strong>MongoDB, MySQL, PostgreSQL, SQLite y TiDB Cloud</strong>.
		</p>
		<p class="summary-paragraph" data-i18n="skills.summary2">
			En el frontend, construyo interfaces dinámicas, responsivas y accesibles utilizando <strong>HTML5, CSS3, JavaScript y EJS</strong>, priorizando siempre la experiencia del usuario y la velocidad de carga.
		</p>
	</div>

	<div class="skills-list-grid">
		<% skillsPorCategoria.forEach(categoria => { %>
		<div class="skill-category-block">
			<h3 data-lang-es="<%= categoria.categoria %>" data-lang-en="<%= categoria.categoria_en || categoria.categoria %>"><%= categoria.categoria %></h3>
			<div class="tags-container">
				<% categoria.tags.forEach(tag => { %>
				<%
					let deviconClass = '';
					let iconImg = '';
					const cleanTag = tag.toLowerCase().split('(')[0].trim();
					switch (cleanTag) {
						case 'node.js':
							deviconClass = 'devicon-nodejs-plain colored';
							break;
						case '.net 10':
						case '.net':
						case 'c#':
							deviconClass = 'devicon-dotnetcore-plain colored';
							break;
						case 'blazor':
							deviconClass = 'devicon-blazor-original colored';
							break;
						case 'tailwind css':
						case 'tailwind':
							deviconClass = 'devicon-tailwindcss-plain colored';
							break;
						case 'express':
							deviconClass = 'devicon-express-original'; 
							break;
						case 'python':
							deviconClass = 'devicon-python-plain colored';
							break;
						case 'mongodb':
							deviconClass = 'devicon-mongodb-plain colored';
							break;
						case 'mysql':
							deviconClass = 'devicon-mysql-plain colored';
							break;
						case 'postgresql':
							deviconClass = 'devicon-postgresql-plain colored';
							break;
						case 'sqlite':
							deviconClass = 'devicon-sqlite-plain colored';
							break;
						case 'html5':
							deviconClass = 'devicon-html5-plain colored';
							break;
						case 'css3':
							deviconClass = 'devicon-css3-plain colored';
							break;
						case 'javascript':
							deviconClass = 'devicon-javascript-plain colored';
							break;
						case 'bootstrap':
							deviconClass = 'devicon-bootstrap-plain colored';
							break;
						case 'vercel':
							deviconClass = 'devicon-vercel-original';
							break;
						case 'chart.js':
							deviconClass = 'devicon-chartjs-plain colored';
							break;
						case 'tidb cloud':
							iconImg = '/images/tidb.svg';
							break;
						default:
							deviconClass = ''; 
							break;
					}
				%>

				<span class="tag skill-tag <%= (deviconClass || iconImg) ? 'has-logo' : '' %>">
					<% if (deviconClass) { %>
						<i class="tag-icon <%= deviconClass %>"></i>
					<% } else if (iconImg) { %>
						<img class="tag-icon tag-icon-img" src="<%= iconImg %>" alt="<%= tag %> logo" width="18" height="18" loading="lazy" />
					<% } %>
					<%= tag %>
				</span>
			<% }) %>

			</div>
		</div>
		<% }) %>
	</div>
</section>
