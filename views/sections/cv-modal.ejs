<div id="cv-modal" class="modal cv-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cv-modal-title">
    <div class="modal-backdrop" id="cv-modal-backdrop"></div>
    <div class="cv-modal-box">

        <!-- HEADER DEL MODAL CV -->
        <div class="cv-modal-header">

            <!-- Título -->
            <div class="cv-modal-title-group">
                <span class="case-study-pill cv-pill">CV</span>
                <h2 id="cv-modal-title">Luis Rodríguez — Full Stack Developer</h2>
            </div>

            <!-- Idioma + Acciones + Cerrar -->
            <div class="cv-modal-controls">

                <!-- Toggle idioma -->
                <div class="cv-lang-toggle" role="group" aria-label="Seleccionar idioma del CV">
                    <button class="cv-lang-btn active" id="cv-lang-es" data-lang="es" aria-pressed="true">ES</button>
                    <button class="cv-lang-btn" id="cv-lang-en" data-lang="en" aria-pressed="false">EN</button>
                </div>

                <!-- Botón Abrir -->
                <a id="cv-open-tab" href="/images/Curriculum Luigi.pdf" target="_blank" class="btn btn-primary btn-sm cv-action-btn" title="Abrir en pestaña nueva">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                    <span class="btn-label-text">Abrir</span>
                </a>

                <!-- Botón Descargar -->
                <a id="cv-download-btn" href="/images/Curriculum Luigi.pdf" download="Curriculum_Luis_Rodriguez.pdf" class="btn btn-secondary btn-sm cv-action-btn" title="Descargar PDF">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span class="btn-label-text">Descargar</span>
                </a>

                <!-- Botón Cerrar -->
                <button class="close-btn" id="close-cv-modal" aria-label="Cerrar visor de CV">&times;</button>
            </div>
        </div>

        <!-- VISOR PDF EN ESPAÑOL (por defecto) -->
        <div id="cv-viewer-es" class="cv-pdf-viewer">
            <iframe
                src="/images/Curriculum Luigi.pdf#view=FitH&toolbar=0"
                title="Curriculum Vitae en Español - Luis Rodríguez"
                class="cv-pdf-iframe"
                loading="lazy"
            ></iframe>
        </div>

        <!-- VISOR PDF EN INGLÉS -->
        <div id="cv-viewer-en" class="cv-pdf-viewer" style="display:none;">
            <iframe
                src="/images/CV_Luis_Rodriguez.pdf#view=FitH&toolbar=0"
                title="Curriculum Vitae in English - Luis Rodriguez"
                class="cv-pdf-iframe"
                loading="lazy"
            ></iframe>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const langEsBtn = document.getElementById('cv-lang-es');
    const langEnBtn = document.getElementById('cv-lang-en');
    const viewerEs  = document.getElementById('cv-viewer-es');
    const viewerEn  = document.getElementById('cv-viewer-en');
    const openTabBtn    = document.getElementById('cv-open-tab');
    const downloadBtn   = document.getElementById('cv-download-btn');

    if (!langEsBtn || !langEnBtn) return;

    function switchLang(lang) {
        if (lang === 'es') {
            viewerEs.style.display = 'flex';
            viewerEn.style.display = 'none';
            langEsBtn.classList.add('active');
            langEnBtn.classList.remove('active');
            langEsBtn.setAttribute('aria-pressed', 'true');
            langEnBtn.setAttribute('aria-pressed', 'false');
            // Botones apuntan al CV en español
            openTabBtn.href = '/images/Curriculum Luigi.pdf';
            downloadBtn.href = '/images/Curriculum Luigi.pdf';
            downloadBtn.setAttribute('download', 'Curriculum_Luis_Rodriguez.pdf');
        } else {
            viewerEs.style.display = 'none';
            viewerEn.style.display = 'flex';
            langEsBtn.classList.remove('active');
            langEnBtn.classList.add('active');
            langEsBtn.setAttribute('aria-pressed', 'false');
            langEnBtn.setAttribute('aria-pressed', 'true');
            // Botones apuntan al CV en inglés
            openTabBtn.href = '/images/CV_Luis_Rodriguez.pdf';
            downloadBtn.href = '/images/CV_Luis_Rodriguez.pdf';
            downloadBtn.setAttribute('download', 'CV_Luis_Rodriguez.pdf');
        }
    }

    langEsBtn.addEventListener('click', () => switchLang('es'));
    langEnBtn.addEventListener('click', () => switchLang('en'));
});
</script>
